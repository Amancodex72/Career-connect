<!DOCTYPE html>
<html lang="en">
<head><link rel="stylesheet" href="style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CareerConnect</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7fb;
            color: #172033;
        }

        header {
            background: #172a46;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            font-size: 28px;
        }

        header p {
            margin-top: 6px;
            color: #cbd5e1;
        }

        .hero {
            padding: 50px 20px;
            text-align: center;
            background: white;
        }

        .hero h2 {
            font-size: 32px;
            margin-bottom: 15px;
        }

        .hero p {
            color: #64748b;
            max-width: 650px;
            margin: auto;
            line-height: 1.6;
        }

        .buttons {
            margin-top: 25px;
        }

        button {
            border: none;
            padding: 13px 22px;
            margin: 5px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
            background: #2563eb;
            color: white;
        }

        button:hover {
            background: #1d4ed8;
        }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            padding: 20px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            text-align: center;
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            color: #64748b;
        }

        footer {
            margin-top: 50px;
            padding: 20px;
            background: #172a46;
            color: white;
            text-align: center;
        }
    </style>
</head>

<body>

<header>
    <h1>CareerConnect</h1>
    <p>College Internship & Placement Management System</p>
</header>

<section class="hero">
    <h2>Build Your Career With Confidence</h2>

    <p>
        CareerConnect helps students discover internships and placement
        opportunities, manage applications and track their career journey.
    </p>

    <div class="buttons">
        <button onclick="studentLogin()">Student Login</button>
        <button onclick="adminLogin()">Admin Login</button>
    </div>
</section>

<div class="container">

    <div class="cards">

        <div class="card">
            <h3>🎓 Students</h3>
            <p>Manage profile, skills and applications.</p>
        </div>

        <div class="card">
            <h3>💼 Internships</h3>
            <p>Find suitable internship opportunities.</p>
        </div>

        <div class="card">
            <h3>🏢 Companies</h3>
            <p>Manage companies and job opportunities.</p>
        </div>

        <div class="card">
            <h3>📊 Analytics</h3>
            <p>View placement and performance statistics.</p>
        </div>

    </div>

</div>

<footer>
    <p>© 2026 CareerConnect | College Placement Portal</p>
</footer>

