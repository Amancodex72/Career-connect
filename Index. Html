<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #111827, #2563eb);
            color: white;
            min-height: 100vh;
        }

        header {
            padding: 25px;
            text-align: center;
        }

        header h2 {
            font-size: 26px;
        }

        main {
            min-height: 80vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

        h1 {
            font-size: 42px;
            margin-bottom: 20px;
        }

        p {
            font-size: 18px;
            margin-bottom: 30px;
        }

        button {
            padding: 14px 30px;
            border: none;
            border-radius: 10px;
            background: white;
            color: #2563eb;
            font-size: 17px;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <header>
        <h2>My Website</h2>
    </header>

    <main>
        <h1>Welcome to My Website 🚀</h1>
        <p>This is my first live website.</p>
        <button>Get Started</button>
    </main>

</body>
</html>
