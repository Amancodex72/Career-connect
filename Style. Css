* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    color: #222;
}

header {
    background: #111;
    color: white;
    padding: 20px;
    text-align: center;
}

main {
    padding: 30px 20px;
    text-align: center;
}

h1 {
    font-size: 35px;
    margin-bottom: 15px;
}

p {
    font-size: 18px;
    margin-bottom: 20px;
}

button {
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    background: #111;
    color: white;
    font-size: 16px;
}
